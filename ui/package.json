{
  "name": "@manoir-app/ui-workspace",
  "private": true,
  "scripts": {
    "build:adminui": "npm run build:bootstrap && npm run build:front",
    "dev:bootstrap": "npm --prefix ./MaNoir.Core.AdminUi.Bootstrap run dev",
    "dev:bootstrap:local": "npm --prefix ./MaNoir.Core.AdminUi.Bootstrap run dev",
    "build:bootstrap": "npm --prefix ./MaNoir.Core.AdminUi.Bootstrap run build",
    "typecheck:bootstrap": "npm --prefix ./MaNoir.Core.AdminUi.Bootstrap run typecheck",
    "dev:front": "npm --prefix ./MaNoir.Core.AdminUi.Front run dev",
