<Project>
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
  </PropertyGroup>

  <ItemGroup>
    <!-- Keep NuGet dependency versions centralized here when package references are introduced. -->
    <PackageVersion Include="MongoDB.Bson" Version="2.11.1" />
    <PackageVersion Include="Newtonsoft.Json" Version="13.0.2" />
  </ItemGroup>
</Project>